{
  "name": "apprentice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A study desk for textbooks: read, mark up, ask, draw, and remember.",
  "author": "justin06lee",
  "main": "dist-electron/main.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build:web": "vite build",
    "build:main": "bun scripts/build-main.ts",
    "build": "bun run build:web && bun run build:main",
    "build:app": "electron-builder",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "bun test desktop",
    "parse": "bun scripts/parse.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@justin06lee/yagami": "file:../yagami",
    "@types/bun": "^1.4.2",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.16",
    "electron": "^44",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "katex": "^0.19.0",
    "lucide-react": "^1.49.0",
    "marked": "^18.0.14",
    "mupdf": "^1.28.1",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-fsrs": "^5.4.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.justin06lee.apprentice",
    "productName": "apprentice",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "dist-web/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "linux": {
      "target": [{
        "target": "dir"
      }],
      "category": "Education"
    },
    "mac": {
      "target": [{
        "target": "dir",
        "arch": ["arm64"]
      }],
      "category": "public.app-category.education"
    }
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}
